{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changes.schema.json",
  "title": "editor-agent/runs/<YYYY-MM-DD>.changes.json - what the editor agent changed and where each fact came from",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "changes"],
  "$defs": {
    "day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "published"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://[^\\s/]+\\.[^\\s]+$"},
        "published": {"$ref": "#/$defs/day", "description": "publication (or last-updated) date of the page, Bangkok date"},
        "publisher": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "section", "keys", "summary_th", "sources", "confidence"],
      "properties": {
        "file": {"enum": ["world-data", "gold"]},
        "section": {"enum": ["meta", "conflicts", "economies", "chokepoints", "indicators", "analysis_th", "gold"]},
        "keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "conflict id / economy iso / chokepoint name_th / indicator label_th / 'analysis_th' / gold top-level key"},
        "fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "summary_th": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  },
  "properties": {
    "date": {"$ref": "#/$defs/day", "description": "run date, Asia/Bangkok"},
    "run_started_at": {"type": "string"},
    "session_id": {"type": "string"},
    "base_commit": {"type": "string"},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "added": {"type": "array", "items": {"$ref": "#/$defs/change"}, "description": "new items (a major new crisis needs >= 2 independent sources)"},
    "removed": {"type": "array", "items": {"$ref": "#/$defs/change"}, "description": "items deleted from the data (prefer marking them ended)"},
    "reviewed_unchanged": {"type": "array", "items": {"type": "string"}, "description": "keys researched with no material change"}
  }
}
