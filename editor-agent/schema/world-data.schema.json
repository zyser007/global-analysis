{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-data.schema.json",
  "title": "data/world-data.json (embedded into site/index.html by tools/build.py)",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "conflicts", "economies", "chokepoints", "indicators", "analysis_th"],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "url": {"type": "string", "pattern": "^https?://[^\\s/]+\\.[^\\s]+$"},
    "lat": {"type": "number", "minimum": -90, "maximum": 90},
    "lon": {"type": "number", "minimum": -180, "maximum": 180},
    "pct": {"type": ["number", "null"]}
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["updated", "sample", "title"],
      "properties": {
        "updated": {"$ref": "#/$defs/day", "description": "date (Bangkok) the background data was last researched"},
        "sample": {"type": "boolean"},
        "title": {"$ref": "#/$defs/text", "description": "page title; must carry no month or 'now' word (dates live in basis_th)"},
        "basis_th": {"$ref": "#/$defs/text", "description": "date range of the research shown in the footer, e.g. '31 ต.ค.–2 พ.ย. 2569'"}
      }
    },
    "conflicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_th", "lat", "lon", "type", "intensity", "status_th", "summary_th", "deaths_est", "displaced", "confidence", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
          "name_th": {"$ref": "#/$defs/text"},
          "lat": {"$ref": "#/$defs/lat"},
          "lon": {"$ref": "#/$defs/lon"},
          "type": {"enum": ["interstate", "civil", "insurgency", "tension", "ceasefire"]},
          "intensity": {"type": "integer", "minimum": 1, "maximum": 5},
          "status_th": {"$ref": "#/$defs/text"},
          "summary_th": {"$ref": "#/$defs/text"},
          "deaths_est": {"$ref": "#/$defs/text"},
          "displaced": {"$ref": "#/$defs/text"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/url"}}
        }
      }
    },
    "economies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iso", "name_th", "lat", "lon", "gdp_growth_2026", "gdp_growth_2027", "inflation", "policy_rate", "health", "note_th", "sources"],
        "properties": {
          "iso": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "name_th": {"$ref": "#/$defs/text"},
          "lat": {"$ref": "#/$defs/lat"},
          "lon": {"$ref": "#/$defs/lon"},
          "gdp_growth_2026": {"type": "number"},
          "gdp_growth_2027": {"$ref": "#/$defs/pct"},
          "inflation": {"$ref": "#/$defs/pct"},
          "policy_rate": {"$ref": "#/$defs/pct"},
          "health": {"enum": ["strong", "stable", "weak", "crisis"]},
          "note_th": {"$ref": "#/$defs/text"},
          "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/url"}}
        }
      }
    },
    "chokepoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name_th", "lat", "lon", "level", "note_th"],
        "properties": {
          "name_th": {"$ref": "#/$defs/text"},
          "lat": {"$ref": "#/$defs/lat"},
          "lon": {"$ref": "#/$defs/lon"},
          "level": {"type": "integer", "minimum": 1, "maximum": 3},
          "note_th": {"$ref": "#/$defs/text"}
        }
      }
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label_th", "value", "delta_th", "trend", "as_of", "source"],
        "properties": {
          "label_th": {"$ref": "#/$defs/text"},
          "value": {"$ref": "#/$defs/text"},
          "delta_th": {"$ref": "#/$defs/text"},
          "trend": {"enum": ["up", "down", "flat"]},
          "as_of": {"$ref": "#/$defs/day"},
          "source": {"$ref": "#/$defs/url"}
        }
      }
    },
    "analysis_th": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "points", "thailand", "risks"],
      "properties": {
        "headline": {"$ref": "#/$defs/text"},
        "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "thailand": {"$ref": "#/$defs/text"},
        "risks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    }
  }
}
